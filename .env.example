# Copy this file to .env and fill in your values.
# python-dotenv loads .env automatically when present.

# --- LLM API keys ---
ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# --- PostgreSQL connection ---
# Defaults (localhost TCP) work for a standard Windows PostgreSQL install.
# Uncomment and override only if your setup differs.
# DB_HOST=localhost
# DB_PORT=1111
# DB_NAME=prompt_flow
# DB_USER=baotn
# DB_PASSWORD=

# --- Obsidian vault path override ---
# Uncomment to point to a non-default vault location.
# OBSIDIAN_VAULT_PATH=C:/Users/baotn/Obsidian Vaults/Main Vault

# Copy this file to .env and fill in your values.
# python-dotenv loads .env automatically when present.
# .env is gitignored — never commit real credentials.

# --- Obsidian vault path (REQUIRED) ---
# Set this to the absolute path of your Obsidian vault on the current device.
#
# Linux:
# OBSIDIAN_VAULT_PATH=/home/<user>/Documents/Obsidian/Main Vault
#
# Windows (native):
# OBSIDIAN_VAULT_PATH=C:/Users/<user>/Obsidian Vaults/Main Vault
#
# Windows Subsystem for Linux (WSL):
# OBSIDIAN_VAULT_PATH=/mnt/c/Users/<user>/Obsidian Vaults/Main Vault
OBSIDIAN_VAULT_PATH=

# --- PostgreSQL connection ---
# Defaults work for a local PostgreSQL install using Unix socket auth (Linux).
# Override only what differs from the defaults shown in paths.py.
#
# Linux (Unix socket, no password needed):
# DB_HOST=/var/run/postgresql
# DB_PORT=5432
# DB_NAME=prompt_flow
# DB_USER=
# DB_PASSWORD=
#
# Windows / Supabase / remote (TCP):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=prompt_flow
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
#
# Supabase (get connection string from project Settings → Database):
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_supabase_password

# --- LLM API keys (optional, only needed for cloud models) ---
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

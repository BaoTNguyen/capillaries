# Copy this file to .env and fill in your values.
# python-dotenv loads .env automatically when present.
# .env is gitignored — never commit real credentials.

# --- Prompt and skill directories ---
# Where your .md prompt/skill files live on disk.
# Defaults to ~/.capillaries/prompts/ and ~/.capillaries/skills/ if unset.
# PROMPTS_PATH=
# SKILLS_PATH=

# --- Obsidian vault (optional) ---
# Only needed if you use Obsidian and want vault sync (obsidian_sync package).
# If set, PROMPTS_PATH and SKILLS_PATH default to vault subdirectories.
# OBSIDIAN_VAULT_PATH=

# --- PostgreSQL ---
# Defaults work for local PostgreSQL with Unix socket auth (Linux).
# Override only what differs from the defaults shown below.
#
# Linux (Unix socket, no password needed):
# DB_HOST=/var/run/postgresql
# DB_PORT=5432
# DB_NAME=capillaries
# DB_USER=
# DB_PASSWORD=
#
# Windows / remote (TCP):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=capillaries
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# --- Embedding server ---
# Default: local server via scripts/serve_embeddings.py (snowflake-arctic-embed-m-v2.0).
# For external APIs (e.g., OpenAI), set URL and model name.
# Note: DB schema uses VECTOR(768) — external models must match this dimension.
# EMBED_URL=http://127.0.0.1:8003/v1/embeddings
# EMBED_MODEL=snowflake-arctic-embed-m-v2.0

# --- Reranker device ---
# Set to "cuda" if you have a GPU; defaults to "cpu".
# RERANKER_DEVICE=cpu

# --- LLM API keys (optional) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

      "Bash(wc -l /c/Users/baotn/Coding/Projects/capillaries/*.py 2>/dev/null | tail -1)",
      "Bash(find /c/Users/baotn/Coding/Projects/capillaries -type f \\\\\\( -name \"*.jsonl\" -o -name \"*.ndjson\" -o -name \"sample*\" -o -name \"*example*\" -o -name \"*test*\" \\\\\\) 2>/dev/null | head -20)",
      "Bash(find \"/c/Users/baotn\" -name \"*.md\" -path \"*/Prompts/*\" 2>/dev/null | grep -v Clippings | head -20)",
      "WebSearch"
    ]
  },
  "hooks": {

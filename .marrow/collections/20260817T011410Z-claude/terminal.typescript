 get written by the classifier directly, not via [200Gault sync [211G          [222G   [226G    [231G           [243G [245G  [2C[1B├──────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────┼────────────────────────┼─────────────────────────────────────────────────────────────────────────────────────────────────────────┤[2C[1B│ —                    │ [38;2;177;185;249mtitle[39m, [38;2;177;185;249mfile_path[39m, [38;2;177;185;249mprompt_text[39m, [38;2;177;185;249mcontent_hash[39m, [38;2;177;185;249mfile_mtime[39m                                    │ DB-derived from the    │ not frontmatter fields                                                                                  │[4C[1B [28G      [35G          [46G            [59G             [73G          [121Gfile its[130Glf    [137G   [146G   [150G           [162G      [2C[1B├──────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────┼────────────────────────┼─────────────────────────────────────────────────────────────────────────────────────────────────────────┤[2C[1B│ —                    │ [38;2;177;185;249mmetadata_confidence[39m, [38;2;177;185;249mclassification_version[39m, [38;2;177;185;249mlast_classified[39m, [38;2;177;185;249mbackfill_status[39m, [38;2;177;185;249msource[39m,     │ [1mDB-only[22m                │ no Obsidian representation at all                                                                       │[4C[1B [29G[38;2;177;185;249mod[32Gli[35Gy[39m, [38;2;177;185;249membe[43Gding[49Gembedding_version[39m, [38;2;177;185;249msearch_tsv[39m           [90G                [107G       [121G       [146G  [149G        [158G              [173G  [176G   [2C[1B└──────────────────────┴────────────────────────────────────────────────────────────────────────────────────────────┴────────────────────────┴─────────────────────────────────────────────────────────────────────────────────────────────────────────┘[2C[1B[K[2C[1B[1mStale in [38;2;177;185;249mdocs/schema.md[39m, not real:[38G[22m[38;2;177;185;249mprompt_id[48G[39mis[51Gdocumented[62Gas[65Ga[67G[38;2;177;185;249mvarchar[75G[39mPK[78Gequal[84Gto[87Gthe[91Gfilename[100G—[102Gactual[109Gschema[116Ghas[120G[38;2;177;185;249mprompt_id UUID PK[138G[39mwith[143G[38;2;177;185;249mtitle VARCHAR UNIQUE[164G[39mholding[172Gthe[176Gfilename.[186G[38;2;177;185;249mprimary_stage[39m,[201G[38;2;177;185;249mexpected_input[39m,[217G[38;2;177;185;249mexpected_output[233G[39mare[237Gdocumented[248Gbut[2C[1Bdon't exist in [38;2;177;185;249msetup.py[39m at all — either dropped[51Gand the doc never updated,[78Gor p[83Ganned and n[95Gver applied.[K[2C[1B[K[2C[1B[1mSkills: Postgres only, no Obsidian[2C[1B[22m[K[2C[1B[38;2;177;185;249mskills.skills[17G[39mhas[21Gno[24Gvault[30Gfile,[36Gno[39Gfrontmatter[51Gsync[56Gmodule[63G—[65GI[67Gchecked,[76Gthere's[84Gnothing[92Ganalogous[102Gto[105G[38;2;177;185;249mobsidian_sync/[120G[39mfor[124Gskills.[132GIt's[137Gpopulated[147Gonly[152Gvia[156G[38;2;177;185;249mSkillPromoter[170G[39m([38;2;177;185;249mpromote.py[39m),[184Gwhich[190Gderives[198Gits[202Gtaxonomy[211Gfields[218Gby[221Gunioning[230Gthe[234Gtaxonomy[243Gof[246Gthe[2C[1Bprompt steps it'[21Gbuilt from.[K[2C[1B[K[2C[1B[38;2;177;185;249mskills.skills[17G[39mcolumns:[26G[38;2;177;185;249mskill_id[39m,[36G[38;2;177;185;249mname[39m,[42G[38;2;177;185;249mslug[47G[39m(unique,[56Gversioned[66Gkey),[72G[38;2;177;185;249mrouting_description[39m,[93G[38;2;177;185;249msteps[99G[39m(JSONB:[107G[38;2;177;185;249m[{prompt_id, stage, step_order, rationale, pinned_hash}][39m),[166G[38;2;177;185;249mdomain[39m/[38;2;177;185;249mintent[39m/[38;2;177;185;249mtask_type[39m/[38;2;177;185;249mcomplexi
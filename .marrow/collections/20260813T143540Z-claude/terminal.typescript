92;2;0mmatches[48;2;61;1;0m |                                                                                                                                                  [5C[1B[38;2;80;200;80m[48;2;2;40;0m 264 +[38;2;248;248;242m| Prompt edited upstream | Re-chunk whole; embeddings [48;2;4;71;0mare[48;2;2;40;0m [48;2;4;71;0mreused by [48;2;2;40;0m`content_hash`[48;2;4;71;0m,[48;2;2;40;0m [48;2;4;71;0macross[48;2;2;40;0m [48;2;4;71;0mruns and across prompts sharing a boilerplate section [48;2;2;40;0m|                                                                                          [5C[1B[49m[2m 265 [22m [5C[1B[38;2;80;200;80m[48;2;2;40;0m 266 +[38;2;248;248;242m### Status, and one honest caveat                                                                                                                                                                                                           [5C[1B[38;2;80;200;80m 267 +[38;2;248;248;242m                                                                                                                                                                                                                                            [5C[1B[38;2;80;200;80m 268 +[38;2;248;248;242mBuilt and backfilled. `prompt_chunks` holds 2 072 rows, all embedded, all with                                                                                                                                                              [5C[1B[38;2;80;200;80m 269 +[38;2;248;248;242mboth tsvectors, covering all 916 parents. Offsets verified: zero rows where                                                                                                                                                                 [5C[1B[38;2;80;200;80m 270 +[38;2;248;248;242m`prompt_text[char_start:char_end] ≠ chunk_text`.                                                                                                                                                                                            [5C[1B[38;2;80;200;80m 271 +[38;2;248;248;242m                                                                                                                                                                                                                                            [5C[1B[38;2;80;200;80m 272 +[38;2;248;248;242m**Nothing reads this table yet.** `retriever.py` still queries `prompts`, so                                                                                                                                                                [5C[1B[38;2;80;200;80m 273 +[38;2;248;248;242mlive retrieval is unchanged and nothing is at risk.                                                                                                                                                                                         [5C[1B[38;2;80;200;80m 274 +[38;2;248;248;242m                                                                                                                                                                                                                                            [5C[1B[38;2;80;200;80m 275 +[38;2;248;248;242mThat last point is deliberate, because the obvious next move — point retrieval                                                                                                                                                              [5C[1B[38;2;80;200;80m 276 +[38;2;248;248;242mat the chunks — is not yet justified by evidence. Two probes:                                                                                                                                                                               [5C[1B[38;2;80;200;80m 277 +[38;2;248;248;242m                                                                                                                                                                                                                                            [5C[1B[38;2;80;200;80m 278 +[38;2;248;248;242m- 30 queries drawn verbatim from content past char 4 000: recall@10 was 4/30                                                                                                                                                                [5C[1B[38;2;80;200;80m 279 +[38;2;248;248;242m  under the old whole-prompt index and 2/30 under chunks. At n=30 and p≈0.1 the                                                                                                                                                             [5C[1B[38;2;80;200;80m 280 +[38;2;248;248;242m  difference is inside the noise, so this says nothing except that both are bad                                                                                                                                                             [5C[1B[38;2;80;200;80m 281 +[38;2;248;248;242m  at verbatim-excerpt probes — which is expected, since the query prefix on                                                                                                                                                                 [5C[1B[38;2;80;200;80m 282 +[38;2;248;248;242m  `arctic-embed` is built for questions, not passages.                                                                                                                                                                                      [5C[1B[38;2;80;200;80m 283 +[38;2;248;248;242m- 60 natural-language queries from `serving_log`: top-1 changed for **59 of                                                                                                                                                                 [5C[1B[38;2;80;200;80m 284 +[38;2;248;248;242m  60**. Median top-1 similarity rose 0.443 → 0.606, but that comparison is not                                                                                                                                                              [5C[1B[38;2;80;200;80m 285 +[38;2;248;248;242m  apples to apples — chunks are shorter, and cosine to a short query rises                                                                                                                                                                  [5C[1B[38;2;80;200;80m 286 +[38;2;248;248;242m  mechanically as the document shortens.                                                                                                                                                                                                    [5C[1B[38;2;80;200;80m 287 +[38;2;248;248;242m                                                                                                                                                                                                                                            [5C[1B[38;2;80;200;80m 288 +[38;2;248;248;242mSo chunking has reshuffled ranking almost completely, and there is currently no                                                                                                                                                             [5C[1B[38;2;80;200;80m 289 +[38;2;248;248;242mway to tell whether that is an improvement. That is exactly the failure mode §7                                                                                                                                                             [5C[1B[38;2;80;200;80m 290 +[38;2;248;248;242mPhase 1 exists to prevent, and I built Phase 2 before it. **Do not switch                                                                                                                                                                   [5C[1B[38;2;80;200;80m 291 +[38;2;248;248;242m`retriever.py` over to chunks until the labeled eval set exists** — build it,                                                                                                                                                               [5C[1B[38;2;80;200;80m 292 +[38;2;248;248;242mscore the old index, score the new one, then cut over on the number.                                                                                                                                                                        [5C[1B[38;2;80;200;80m 293 +[38;2;248;248;242m                                                                                                                                                                                                                                            [5C[1B[49m[2m 294 [22m ---[5C[1B[2m 295 [22m [5C[1B[2m 296 [22m ## 3. Placeholder filling[2B[38;2;215;119;87m·[3GProofing… [38;2;153;153;153m(7m 29s · ↓[25G29.7k tokens)[1B  ⎿  Tip: Use /permissions to pre-approve and pre-deny bash, edit, and MCP tools[39m[61;1H[59;3H[?25h[?2026l[?2026h[?25l[H[9G[38;2;220;90;90m[48;2;61;1;0m3[12G[38;2;248;248;242mOn [16Ghis corpus: ~60% of prompts (th[48G 374[53Gunder 1 500 chars, plus part of the[8C[1B[38;2;220;90;90m4[12G[38;2;248;248;242mnext bucket) becom[32Ga single chunk equal to the whole[66Gprompt. Chunking[83Gonly[8C[1B[38;2;220;90;90m5[12G[38;2;248;248;242mactually splits[28Gthe[32Gtail[37G—[39Gwhich[45Gis[48Gprecisely[58Gthe[62G276[66Gcurrently[76Gbeing[8C[1B[38;2;220;90;90m6[12G[38;2;248;248;242mtruncated.[5C[1B[38;2;220;90;90m 217 -[38;2;248;248;242m                                                                                                                                                                                                                                            [8C[1B[49m[2m4[12G[22m### Small-to-big[8C[1B[2m5[12G[22m[39m[K[5C[1B[38;2;248;248;242m[2m 216 [22m Retrieve chunks, return parents. The chunk is the ranking unit; t